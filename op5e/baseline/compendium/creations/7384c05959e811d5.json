{
  "_id": "7384c05959e811d5",
  "name": "Dragon's Breath",
  "type": "spell",
  "img": "icons/magic/symbols/runes-star-blue.webp",
  "system": {
    "description": {
      "value": "<p>You touch one willing creature and give it the ability to spew energy from its mouth, provided it has one. Choose acid, cold, fire, lightning, or poison. Until the creation ends, the creature can use an action to exhale energy of the chosen type in a 15-foot cone. Each creature in that area must make a Dexterity saving throw, taking 3d8 damage of the chosen type on a failed save, or half as much damage on a successful one.</p><p><strong>At Higher Levels.</strong> When you use this creation using a creation slot of 3rd level or higher, the damage increases by 1d8 for each slot level above 2nd.</p>",
      "chat": ""
    },
