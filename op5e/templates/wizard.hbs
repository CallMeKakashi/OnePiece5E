<section class="op5e-cc">
  <header class="op5e-cc__header">
    <h2>OP5e Character Creator</h2>
    <div class="op5e-cc__meta">
      <span>Step {{inc stepIndex}} / {{steps.length}}: {{step}}</span>
      <span class="op5e-cc__meta-small">Draft: {{draft.id}}</span>
    </div>
  </header>

  <div class="op5e-cc__scroll">
  {{#if inferredPcLocked}}
    <p class="op5e-cc__hint">You are not a GM, so this wizard will create a PC.</p>
  {{else}}
    <div class="op5e-cc__row">
      <label>Type</label>
      <select name="actorKind">
        <option value="pc" {{#if (eq draft.actorKind "pc")}}selected{{/if}}>PC (Character)</option>
        <option value="npc" {{#if (eq draft.actorKind "npc")}}selected{{/if}}>NPC</option>
      </select>
    </div>
  {{/if}}

  {{#if (eq step "name")}}
    <div class="op5e-cc__row">
      <label>Name</label>
      <input name="name" type="text" value="{{draft.data.name}}" placeholder="Character name" />
    </div>
  {{/if}}

  {{#if (eq step "images")}}
    <div class="op5e-cc__row">
      <label>Portrait image</label>
      <div class="op5e-cc__file">
        <input name="portraitImg" type="text" value="{{draft.data.portraitImg}}" placeholder="Click to browse or paste a path" title="Click to open file picker" />
        <button type="button" data-action="browseImage" data-field="portraitImg">Browse</button>
      </div>
    </div>
    {{#if draft.data.portraitImg}}
      <div class="op5e-cc__preview-row">
        <img class="op5e-cc__preview" src="{{draft.data.portraitImg}}" alt="Portrait preview" />
      </div>
    {{/if}}
    <div class="op5e-cc__row">
      <label>Token image</label>
      <div class="op5e-cc__file">
        <input name="tokenImg" type="text" value="{{draft.data.tokenImg}}" placeholder="Click to browse or paste a path" title="Click to open file picker" />
        <button type="button" data-action="browseImage" data-field="tokenImg">Browse</button>
      </div>
    </div>
    {{#if draft.data.tokenImg}}
      <div class="op5e-cc__preview-row">
        <img class="op5e-cc__preview op5e-cc__preview--token" src="{{draft.data.tokenImg}}" alt="Token preview" />
      </div>
    {{/if}}
    <p class="op5e-cc__hint">Click a path field or Browse to open Foundry's file picker.</p>
  {{/if}}

  {{#if (eq step "species")}}
    <p class="op5e-cc__hint">Choose a species. Granted racial features are listed below.</p>
    <div class="op5e-cc__choices" role="radiogroup" aria-label="Species">
      {{#each choices.species}}
        <label class="op5e-cc__choice">
          <input type="radio" name="speciesId" value="{{_id}}" {{#if (eq _id ../draft.data.speciesId)}}checked{{/if}} />
          {{#if img}}<img class="op5e-cc__choice-img" src="{{img}}" alt="" width="48" height="48" />{{/if}}
          <span class="op5e-cc__choice-label">{{name}}</span>
        </label>
      {{/each}}
    </div>
    {{#if speciesRacialFeats.length}}
      <h4 class="op5e-cc__subhead">Racial features</h4>
      <ul class="op5e-cc__feat-list">
        {{#each speciesRacialFeats}}
          <li class="op5e-cc__feat">
            {{#if img}}<img class="op5e-cc__feat-img" src="{{img}}" alt="" width="32" height="32" />{{/if}}
            <span>{{name}}</span>
          </li>
        {{/each}}
      </ul>
    {{/if}}
  {{/if}}

  {{#if (eq step "background")}}
    <div class="op5e-cc__row">
      <label>Background</label>
      <select name="backgroundId">
        <option value="">— Choose —</option>
        {{#each choices.backgrounds}}
          <option value="{{_id}}" {{#if (eq _id ../draft.data.backgroundId)}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </div>
  {{/if}}

  {{#if (eq step "class")}}
    {{#each classBlocks}}
      <fieldset class="op5e-cc__class">
        <legend>{{#if (eq n 1)}}Class{{else}}Second class — Optional (DM approval){{/if}}</legend>
        <div class="op5e-cc__row">
          <label>Class</label>
          <select name="{{idKey}}">
            <option value="">— {{#if (eq n 1)}}Choose{{else}}None{{/if}} —</option>
            {{#each ../choices.classes}}
              <option value="{{_id}}" {{#if (eq _id (lookup ../../draft.data ../idKey))}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </div>
        <div class="op5e-cc__row">
          <label>Level</label>
          <input name="{{lvKey}}" type="number" min="1" max="20" value="{{level}}" />
        </div>
        <div class="op5e-cc__row">
          <label>Subclass</label>
          <select name="{{subKey}}" {{#unless subclassEnabled}}disabled{{/unless}}>
            <option value="">— {{#if subclassEnabled}}Choose{{else}}{{#if subclassLevel}}unlocks at level {{subclassLevel}}{{else}}pick a class first{{/if}}{{/if}} —</option>
            {{#each subclasses}}
              <option value="{{_id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </div>
      </fieldset>
    {{/each}}
    <p class="op5e-cc__hint">Total level: <strong>{{totalLevel}}</strong> / 20. The book has no multiclass rules; a second class needs DM approval. The character is created at level 1, then levelled one level at a time.</p>
    <div class="op5e-cc__row">
      <label>Hit points per level</label>
      <select name="hpMode">
        <option value="avg" {{#if (eq draft.data.hpMode "avg")}}selected{{/if}}>Average (default)</option>
        <option value="roll" {{#if (eq draft.data.hpMode "roll")}}selected{{/if}}>Roll, never below average</option>
      </select>
    </div>
    <div class="op5e-cc__row">
      <label>Auto-apply default choices (testing)</label>
      <input type="checkbox" name="autoApply" {{#if draft.data.autoApply}}checked{{/if}} />
    </div>
    <p class="op5e-cc__hint">Rolled hit points apply to automatic application only; the manual level-up dialog offers its own Roll button.</p>
  {{/if}}

  {{#if (eq step "abilities")}}
    <div class="op5e-cc__row">
      <label>Method</label>
      <select name="abilityMethod">
        <option value="pointBuy" {{#if (eq draft.data.abilityMethod "pointBuy")}}selected{{/if}}>Point-buy (27)</option>
        <option value="array" {{#if (eq draft.data.abilityMethod "array")}}selected{{/if}}>Standard array</option>
        <option value="ursa" {{#if (eq draft.data.abilityMethod "ursa")}}selected{{/if}}>Ursa Array (variant: 16, 16, 14, 12, 12, 8)</option>
        <option value="roll" {{#if (eq draft.data.abilityMethod "roll")}}selected{{/if}}>Roll</option>
      </select>
    </div>

    <div class="op5e-cc__footer" style="padding: 0;">
      <button type="button" data-action="useArray">Use Standard Array</button>
      <button type="button" data-action="useUrsa">Use Ursa Array</button>
      <button type="button" data-action="rollScores">Roll 4d6 Drop Lowest</button>
    </div>

    <div class="op5e-cc__grid">
      {{#each draft.data.abilities}}
        <div class="op5e-cc__cell">
          <label>{{@key}}</label>
          <input name="ability.{{@key}}" type="number" min="{{abilityMin}}" max="{{abilityMax}}" value="{{this}}" />
        </div>
      {{/each}}
    </div>

    <p class="op5e-cc__hint">
      {{#if (eq draft.data.abilityMethod "ursa")}}
        Ursa Array: assign exactly 16, 16, 14, 12, 12, 8 {{#if abilitiesOk}}(valid){{else}}(not yet a permutation){{/if}}. Racial and feat bonuses come on top.
      {{else}}
        Point-buy: spent <strong>{{pointBuy.spent}}</strong> / {{pointBuy.total}}
        {{#if pointBuy.valid}}(valid){{else}}(must equal 27){{/if}}
      {{/if}}
    </p>
  {{/if}}

  {{#if (eq step "finish")}}
    <div class="op5e-cc__summary">
      <h3>Review</h3>
      <ul>
        <li><strong>Name:</strong> {{draft.data.name}}</li>
        <li><strong>Species:</strong> {{draft.data.speciesId}}</li>
        <li><strong>Background:</strong> {{draft.data.backgroundId}}</li>
        <li><strong>Class:</strong> {{draft.data.classId}} (level {{draft.data.level}})</li>
        {{#if draft.data.classId2}}<li><strong>Second class:</strong> {{draft.data.classId2}} (level {{draft.data.level2}})</li>{{/if}}
        <li><strong>Total level:</strong> {{totalLevel}}</li>
      </ul>
      <p class="op5e-cc__hint">Click Finish to create the actor; advancements and starting equipment are applied automatically.</p>
    </div>
  {{/if}}
  </div>

  <footer class="op5e-cc__footer">
    <button type="button" data-action="back" {{#if (eq stepIndex 0)}}disabled{{/if}}>Back</button>
    <div class="op5e-cc__spacer"></div>
    {{#if canReset}}
      <button type="button" class="danger" data-action="reset">Reset & Restart</button>
    {{/if}}
    {{#if (eq step "finish")}}
      <button type="button" class="primary" data-action="finish">Finish</button>
    {{else}}
      <button type="button" class="primary" data-action="next">Next</button>
    {{/if}}
  </footer>
</section>

